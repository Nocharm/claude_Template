# Anthropic API key (secret) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model for OCR/structuring. Tuning value; change without code edits.
CLAUDE_MODEL=claude-opus-5-5

# Learner's time zone (IANA). Decides when "today" rolls over for streaks/reviews.
TIMEZONE=Asia/Seoul

# Azure Speech (TTS) — key is a secret; region of the Speech resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# Google Gemini (webtoon panels) — key is a secret; model is a tuning value.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Where SQLite and per-book caches live. Default: <repo>/data (Docker uses /data).
# DATA_DIR=
