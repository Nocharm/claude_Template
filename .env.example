# Anthropic API key (secret) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model for OCR/structuring. Tuning value; change without code edits.
CLAUDE_MODEL=claude-opus-5-5

# Learner's time zone (IANA). Decides when "today" rolls over for streaks/reviews.
TIMEZONE=Asia/Seoul

# Where SQLite and per-book caches live. Default: <repo>/data (Docker uses /data).
# DATA_DIR=
